flowchart TB
    NOTE["Architectural view · distinct demonstration paths"]
    subgraph SEM["Interpretation, confirmation, and bounded evidence"]
        direction LR
        H["Human request"] --> M["Probabilistic interpretation<br/>Proposal only"]
        M --> C["Human confirmation<br/>Meaning, not execution approval"]
        C --> E["A2A + MCP<br/>Deterministic specialists<br/>Read-only evidence"]
    end
    subgraph DET["DETERMINISTIC BOUNDARY · AI has no decision authority"]
        direction LR
        A["Formal Intent admission<br/>Authority + provenance"] --> F["Finite planning"]
        F --> P["Policy filtering"] --> S["Risk-first selection"] --> SIM["Exact simulation"]
    end
    E --> A
    ENTRY["Historical Sepolia entry<br/>Prepared/admitted intent · no live model"] -.-> A
    subgraph EXEC["Authorization, execution, and observed outcome"]
        direction LR
        APPROVE["Explicit human approval<br/>Bound plan + simulation"] --> SIGN["Restricted signer<br/>Verify signed bytes"]
        SIGN --> CHAIN["Blockchain execution<br/>Submission + inclusion"]
        CHAIN --> OUT["Deterministic postconditions<br/>Finality + state checks<br/>Bounded verified outcome"]
    end
    SIM --> APPROVE
    NOTE ~~~ H
    OUT ~~~ LIMIT["Policy, approval, replay, and network restrictions are primarily off-chain.<br/>Signer: encrypted software keystore; no model key access."]
    classDef human fill:#f0eaff,stroke:#7352a5,color:#24213b,stroke-width:2px
    classDef model fill:#fff1d5,stroke:#a36512,color:#49310e,stroke-width:2px
    classDef deterministic fill:#edf4fb,stroke:#3e6588,color:#18384f,stroke-width:2px
    classDef chain fill:#e5f4ed,stroke:#38795d,color:#173d2c,stroke-width:2px
    classDef note fill:#ffffff,stroke:#7b8995,color:#354755,stroke-dasharray:5 4
    class H,C,APPROVE human
    class M model
    class E,A,F,P,S,SIM,SIGN deterministic
    class CHAIN,OUT chain
    class NOTE,ENTRY,LIMIT note
